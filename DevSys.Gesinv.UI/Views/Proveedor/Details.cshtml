@model DevSys.Gesinv.UI.Models.ViewModels.ProveedorViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <h4>Proveedor #@Model.ProveedorId</h4>
    <hr />
    <div class="row justify-content-center">
        <div class="card col-10">
            <div class="card-body container-fluid">
                <div class="row row-cols-3">
                    <div class="form-group px-2">
                        <label class="control-label">Contacto</label>
                        <p class="form-control">
                            @Model.Contacto
                        </p>
                    </div>
                    <div class="form-group px-2">
                        <label class="control-label">Razon Social</label>
                        <p class="form-control">
                            @Model.RazonSocial

                        </p>
                    </div>
                    <div class="form-group px-2">
                        <label class="control-label">Ruc</label>
                        <p class="form-control">
                            @Model.Ruc

                        </p>
                    </div>
                </div>
                <div class="row row-cols-3">
                    <div class="form-group px-2">
                        <label class="control-label">Correo</label>
                        <p class="form-control">
                            @Model.Correo

                        </p>
                    </div>
                    <div class="form-group px-2">
                        <label class="control-label">Direccion</label>
                        <p class="form-control">
                            @Model.Direccion

                        </p>
                    </div>
                    <div class="form-group px-2">
                        <label class="control-label">Telefono</label>
                        <p class="form-control">
                            @Model.Telefono
                        </p>
                    </div>
                </div>
                <div class="row row-cols-2">
                    <div class="form-group px-2">
                        <label class="control-label">Plazo</label>
                        <p class="form-control">
                            @Model.Plazo
                        </p>
                    </div>
                    <div class="form-group px-2">
                        <label class="control-label">Tipo</label>
                        <p class="form-control">
                            @Model.NombreTipo
                        </p>
                    </div>
                </div>
                <div class="row row-cols-1">
                    <div class="form-group px-2">
                        <label class="control-label">Estado</label>
                        <p class="form-control">
                            @Model.NombreEstado
                        </p>
                    </div>
                    <div class="form-group px-2">
                        <label class="control-label">Provincia</label>
                        <p class="form-control">
                            @Model.NombreProvincia
                        </p>
                    </div>
                    <div class="form-group px-2">
                        <label class="control-label">Pagina Web</label>
                        <p class="form-control">
                            @Model.PaginaWeb
                        </p>
                    </div>
                </div>

            </div>
            <div class="card-footer" style="background-color: white;">
                <div class="row">
                    <div class="col-6 ">
                        <a class="btn btn-info" asp-action="Index">Volver a la lista</a>
                    </div>
                    <div class="form-group col-6" style="text-align: end;">
                        <a class="btn btn-info" asp-action="Edit" asp-route-id="@Model.ProveedorId">Editar</a>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>